{
  "name": "dx12-zh-learning-workbench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config frontend/vite.config.ts",
    "build": "tsc -b && vite build --config frontend/vite.config.ts",
    "preview": "vite preview --config frontend/vite.config.ts",
    "preview:build": "npm run build && vite preview --config frontend/vite.config.ts --host 127.0.0.1 --port 4174 --strictPort",
    "test": "vitest run --config frontend/vitest.config.ts",
    "test:watch": "vitest --config frontend/vitest.config.ts",
    "check:figures": "node tools/check-figures.mjs",
    "check:translations": "node tools/check-translations.mjs",
    "check:translation-terms": "node tools/check-translation-terms.mjs",
    "check:translations:complete": "node tools/check-translations.mjs --strict"
  },
  "dependencies": {
    "@mdx-js/react": "^3.1.0",
    "@vitejs/plugin-react": "^6.1.1",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "three": "^0.186.0",
    "vite": "^8.3.1"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.185.4",
    "typescript": "~5.7.2",
    "vitest": "^5.0.3"
  }
}
